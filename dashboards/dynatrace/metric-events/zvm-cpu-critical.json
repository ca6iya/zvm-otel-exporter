{
  "schemaId": "builtin:anomaly-detection.metric-events",
  "scope": "environment",
  "value": {
    "enabled": true,
    "summary": "z/VM CPU above 95 percent",
    "queryDefinition": {
      "type": "METRIC_SELECTOR",
      "metricSelector": "zvm.system.cpu.utilization:avg"
    },
    "modelProperties": {
      "type": "STATIC_THRESHOLD",
      "threshold": 0.95,
      "alertOnNoData": false,
      "alertCondition": "ABOVE",
      "violatingSamples": 3,
      "samples": 5,
      "dealertingSamples": 5
    },
    "eventTemplate": {
      "title": "z/VM CPU above 95 percent",
      "description": "zvm.system.cpu.utilization stayed above 0.95.",
      "eventType": "AVAILABILITY",
      "davisMerge": true
    }
  }
}
