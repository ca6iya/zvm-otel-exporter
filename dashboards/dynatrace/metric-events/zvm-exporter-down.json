{
  "schemaId": "builtin:anomaly-detection.metric-events",
  "scope": "environment",
  "value": {
    "enabled": true,
    "summary": "z/VM exporter down",
    "queryDefinition": {
      "type": "METRIC_SELECTOR",
      "metricSelector": "zvm.exporter.up:last"
    },
    "modelProperties": {
      "type": "STATIC_THRESHOLD",
      "threshold": 1,
      "alertCondition": "BELOW",
      "violatingSamples": 3,
      "samples": 5,
      "dealertingSamples": 5
    },
    "eventTemplate": {
      "title": "z/VM exporter down",
      "description": "zvm.exporter.up has been 0. The OTLP stream is stale or Feilong is down.",
      "eventType": "AVAILABILITY",
      "davisMerge": true,
      "severity": "critical"
    }
  }
}
